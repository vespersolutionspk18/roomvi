# Copy to /opt/roomvi/frontend/.env.local on the server (chmod 600).
# Every value below is REQUIRED unless noted.

# Neon — pooled for traffic, direct for the job runner LISTEN connection
DATABASE_URL=postgresql://...@ep-xxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_DIRECT_URL=postgresql://...@ep-xxx.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# fal.ai — every paid model call
FAL_KEY=

# Local disk storage for uploads/masks/renders (writable by the roomvi user)
STORAGE_DIR=./storage

# Generate once: openssl rand -hex 32
SESSION_SECRET=

# Single-user dev session until real auth lands (Phase 8). Remove when auth ships.
ALLOW_DEV_SESSION=1

# Optional: set to 1 to disable the built-in job runner on this box and drain
# jobs with `npm run worker` elsewhere instead.
# DISABLE_JOB_RUNNER=
